# Copy to .env and fill in. Placeholders are safe to commit; .env is not.

# LiveKit Cloud (cloud.livekit.io -> Settings -> Keys)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
# Which voice pipeline answers: ultravox (speech-to-speech) | cascade (Sarvam STT -> Groq LLM -> Sarvam TTS)
PIPELINE=ultravox

ULTRAVOX_API_KEY=your-ultravox-api-key
GROQ_API_KEY=your-groq-api-key
SARVAM_API_KEY=your-sarvam-api-key

# Optional: a different model family to judge tone in evals (OpenAI or Anthropic key)
JUDGE_API_KEY=

# Pins "today" so due dates, days overdue and promise dates are reproducible across
# runs. Leave empty to use the real date (mock due dates will then drift).
TODAY=2026-11-14

# 1 makes the mock payment-link tool fail, to test recovery.
FAIL_PAYMENT_LINK=0

# Which borrower `console`/`agent` calls when the room doesn't say (B001..B008).
BORROWER=B001
# Optional overrides (defaults shown)
ULTRAVOX_VOICE=Priya
SARVAM_SPEAKER=ritu
SARVAM_TTS_MODEL=bulbul:v3
# Cascade LLM: a LiveKit Inference model (uses LiveKit credits) or groq/<model>
CASCADE_LLM=google/gemini-2.5-flash
# Cascade STT: a LiveKit Inference model (deepgram/nova-3) or sarvam
CASCADE_STT=deepgram/nova-3
GROQ_MODEL=openai/gpt-oss-120b
